    <!-- Watchers -->
    <string name="watchers_title">Who\'s reading along?</string>
    <plurals name="watchers_count">
        <item quantity="one">%1$d privileged hook</item>
        <item quantity="other">%1$d privileged hooks</item>
    </plurals>
    <string name="watchers_intro">Apps listed here hold a hook that lets them see or control more than a normal app. Tap one to see everything else it does.</string>
    <string name="watchers_partial_title">Some sources failed</string>
    <string name="watchers_partial_body">These could not be read on this device: %1$s. The rest of the list is complete.</string>
    <string name="watcher_sideloaded">Sideloaded</string>
    <string name="watcher_inactive">granted, not active</string>
    <string name="watcher_notifications">Notification access</string>
    <string name="watcher_notifications_explain">Can read every notification as it arrives: message previews, one-time codes, who is calling. Can also dismiss notifications and press their buttons.</string>
    <string name="watcher_accessibility">Accessibility services</string>
    <string name="watcher_accessibility_explain">Can read what is on screen, including what you type, and can tap, swipe and type on your behalf. The most powerful hook an app can get without root.</string>
    <string name="watcher_admin">Device admin</string>
    <string name="watcher_admin_explain">Can enforce policies such as screen locks or wiping the device, and cannot be uninstalled while active.</string>
    <string name="watcher_ime">Keyboards</string>
    <string name="watcher_ime_explain">Every enabled keyboard can be switched to, and the current one sees everything you type except in password fields that block it.</string>
    <string name="watcher_usage">Usage access</string>
    <string name="watcher_usage_explain">Can see which apps you use, when and for how long.</string>
    <string name="watcher_overlay">Draw over other apps</string>
    <string name="watcher_overlay_explain">Can show windows on top of other apps, which is also how tapjacking and fake login screens work.</string>
    <string name="watcher_vpn">VPN</string>
    <string name="watcher_vpn_explain">All network traffic passes through this app while its VPN is active.</string>
    <string name="watcher_roles">Default apps</string>
    <string name="watcher_roles_explain">Holders of default roles get extra rights: the SMS app reads all messages, the dialer handles calls, the assistant can see the screen when invoked, the home app sees what you launch.</string>
    <string name="watcher_dnd">Do Not Disturb access</string>
    <string name="watcher_dnd_explain">Can change Do Not Disturb rules and see which notifications get through.</string>

